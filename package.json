{
  "name": "nixplayer",
  "version": "1.7.2",
  "description": "NixPlayer - a simple desktop video player with a clean custom top bar",
  "main": "main.js",
  "author": "Nasimul Islam Nasim",
  "nixplayer": {
    "donateUrl": "",
    "homepage": "https://github.com/nixnasim/nixplayer"
  },
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "pack": "electron-builder --dir",
    "release": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.nixplayer.app",
    "productName": "NixPlayer",
    "files": [
      "main.js",
      "preload.js",
      "av.js",
      "webproxy.js",
      "updater.js",
      "renderer/**",
      "build/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": "mp4",
        "name": "NixPlayer.mp4",
        "description": "NixPlayer MP4 File",
        "role": "Viewer",
        "icon": "file-mp4.ico"
      },
      {
        "ext": "m4v",
        "name": "NixPlayer.m4v",
        "description": "NixPlayer M4V File",
        "role": "Viewer",
        "icon": "file-m4v.ico"
      },
      {
        "ext": "mkv",
        "name": "NixPlayer.mkv",
        "description": "NixPlayer MKV File",
        "role": "Viewer",
        "icon": "file-mkv.ico"
      },
      {
        "ext": "webm",
        "name": "NixPlayer.webm",
        "description": "NixPlayer WEBM File",
        "role": "Viewer",
        "icon": "file-webm.ico"
      },
      {
        "ext": "mov",
        "name": "NixPlayer.mov",
        "description": "NixPlayer MOV File",
        "role": "Viewer",
        "icon": "file-mov.ico"
      },
      {
        "ext": "avi",
        "name": "NixPlayer.avi",
        "description": "NixPlayer AVI File",
        "role": "Viewer",
        "icon": "file-avi.ico"
      },
      {
        "ext": "mp3",
        "name": "NixPlayer.mp3",
        "description": "NixPlayer MP3 File",
        "role": "Viewer",
        "icon": "file-mp3.ico"
      },
      {
        "ext": "flac",
        "name": "NixPlayer.flac",
        "description": "NixPlayer FLAC File",
        "role": "Viewer",
        "icon": "file-flac.ico"
      },
      {
        "ext": "wav",
        "name": "NixPlayer.wav",
        "description": "NixPlayer WAV File",
        "role": "Viewer",
        "icon": "file-wav.ico"
      },
      {
        "ext": "ogg",
        "name": "NixPlayer.ogg",
        "description": "NixPlayer OGG File",
        "role": "Viewer",
        "icon": "file-ogg.ico"
      },
      {
        "ext": "m4a",
        "name": "NixPlayer.m4a",
        "description": "NixPlayer M4A File",
        "role": "Viewer",
        "icon": "file-m4a.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "NixPlayer",
      "license": "LICENSE",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "include": "build/installer.nsh"
    },
    "protocols": [
      {
        "name": "NixPlayer link",
        "schemes": [
          "nixplayer"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "CHANGELOG.md",
        "to": "CHANGELOG.md"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "nixnasim",
        "repo": "nixplayer",
        "releaseType": "release"
      }
    ],
    "copyright": "Copyright © 2026 Nasimul Islam Nasim"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "ffmpeg-static": "^5.2.0",
    "hls.js": "^1.5.17"
  },
  "homepage": "https://github.com/nixnasim/nixplayer"
}
