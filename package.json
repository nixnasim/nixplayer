{
  "name": "nixplayer",
  "version": "1.7.1",
  "description": "NixPlayer - a simple desktop video player with a clean custom top bar",
  "main": "main.js",
  "author": "Nasimul Islam Nasim",
  "nixplayer": {
    "donateUrl": "",
    "homepage": "https://github.com/nixnasim/nixplayer"
  },
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "pack": "electron-builder --dir",
    "release": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.nixplayer.app",
    "productName": "NixPlayer",
    "files": [
      "main.js",
      "preload.js",
      "av.js",
      "webproxy.js",
      "updater.js",
      "renderer/**",
      "build/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mp4",
          "m4v",
          "mkv",
          "webm",
          "mov",
          "avi",
          "mp3",
          "flac",
          "wav",
          "ogg",
          "m4a"
        ],
        "name": "NixPlayer.Media",
        "role": "Viewer",
        "description": "NixPlayer Media File",
        "icon": "fileicon.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "NixPlayer",
      "license": "LICENSE",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "include": "build/installer.nsh"
    },
    "protocols": [
      {
        "name": "NixPlayer link",
        "schemes": [
          "nixplayer"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "CHANGELOG.md",
        "to": "CHANGELOG.md"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "nixnasim",
        "repo": "nixplayer",
        "releaseType": "release"
      }
    ],
    "copyright": "Copyright © 2026 Nasimul Islam Nasim"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "ffmpeg-static": "^5.2.0",
    "hls.js": "^1.5.17"
  },
  "homepage": "https://github.com/nixnasim/nixplayer"
}
